# Copy this file to .env and fill in the values. Never commit .env.

# MySQL (the account created by backend/sql/setup_db.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nutrimate_ai
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nutrimate_ai

# At least 32 random characters. One way to make one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Google Gemini (optional). Without a key the assistant uses template answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash

# Optional
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MAX_UPLOAD_MB=4096
# RERANKER=auto
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Accounts created by backend/scripts/seed_demo.py (defaults shown)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=admin12345
# SEED_DEMO_EMAIL=demo@example.com
# SEED_DEMO_PASSWORD=demo12345
